udev_shutdown_hook_handler() {
	status=$1
	module=$2
	if [ "$status" = "pre" ] && [ "$module" = "finish" ]; then
		udevadm settle
		killall `basename $_UDEV_DAEMON` 2>/dev/null
	fi
}

udev_daemon() {
	OPTIONS="/sbin/udev/udevd /sbin/udevd /lib/udev/udevd /lib/systemd/systemd-udevd"

	for o in $OPTIONS; do
		if [ -x "$o" ]; then
			echo $o
			return 0
		fi
	done

	return 1
}

_UDEV_DAEMON=`udev_daemon`

udev_enabled() {
	if [ -z "$_UDEV_DAEMON" ]; then
		msg "WARNING: Cannot find the udev daemon; daemon will not be started in initramfs."
		return 1
	fi

	return 0
}

udev_trigger_root_device() {
	root_link=""
	root_match=""

	case "${bootparam_root:-}" in
		LABEL=?*)
			root_link="/dev/disk/by-label/${bootparam_root#LABEL=}"
			;;
		UUID=?*)
			root_link="/dev/disk/by-uuid/${bootparam_root#UUID=}"
			;;
		PARTLABEL=?*)
			root_match="PARTNAME=${bootparam_root#PARTLABEL=}"
			;;
		PARTUUID=?*)
			root_match="PARTUUID=${bootparam_root#PARTUUID=}"
			;;
		*)
			return 1
			;;
	esac

	# Filesystem labels and UUIDs are not exported in kernel uevents. Trigger
	# block devices so udev can probe them and create the persistent link.
	if [ -n "$root_link" ]; then
		udevadm trigger --subsystem-match=block --action=add || return 1
		udevadm settle || return 1
		[ -e "$root_link" ] || return 1
		udev_trigger_scope="block devices"
		return 0
	fi

	root_devices=$(udevadm trigger --dry-run --verbose \
		--subsystem-match=block "--property-match=$root_match") || return 1

	# udevadm succeeds even when no devices match, so check its dry-run output.
	[ -n "$root_devices" ] || return 1

	udevadm trigger --subsystem-match=block \
		"--property-match=$root_match" --action=add || return 1
	udev_trigger_scope="root device only"
}

udev_run() {
	add_module_pre_hook "udev_shutdown_hook_handler"

	mkdir -p /run
	mkdir -p /var/run

	# Workaround if console=null, systemd-udevd needs valid stdin, stdout and stderr to work
	sh -c "exec 4< /dev/console" || { exec 0> /dev/null; exec 1> /dev/null; exec 2> /dev/null; }

	$_UDEV_DAEMON --daemon
	if [ "${bootparam_initramfs_udev_root_only:-}" = "1" ] &&
	   udev_trigger_root_device; then
		debug "Triggered udev for $udev_trigger_scope"
	else
		udevadm trigger --action=add
	fi
	udevadm settle
}
